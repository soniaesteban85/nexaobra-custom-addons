<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document_image" inherit_id="sale.report_saleorder_document" priority="20">
        <!-- Estilo de tabla con bordes delgados y encabezados azul marino (#1b4c6e) -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="style">border-collapse: collapse; width: 100%; border: 1px solid #1b4c6e;</attribute>
        </xpath>

        <!-- Fondo azul y texto blanco en el encabezado -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//tr" position="attributes">
            <attribute name="style">background-color: #1b4c6e !important; color: #ffffff !important;</attribute>
        </xpath>

        <!-- Columna de Imagen en el Encabezado -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//tr//th[1]" position="before">
            <th name="th_image" class="text-center" style="width: 85px; vertical-align: middle; padding: 8px; color: #ffffff !important; font-weight: bold; border: 1px solid #1b4c6e; text-transform: uppercase;">IMAGEN</th>
        </xpath>

        <!-- Celda de Imagen en las filas de productos -->
        <xpath expr="//table[hasclass('o_main_table')]//tbody//tr//td[1]" position="before">
            <td name="td_image" class="text-center" style="width: 85px; vertical-align: middle; padding: 6px; border: 1px solid #cbd5e1;">
                <t t-if="line.product_id and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)" style="max-height: 65px; max-width: 65px; width: auto; height: auto; object-fit: contain; display: block; margin: 0 auto;" alt="Producto"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
