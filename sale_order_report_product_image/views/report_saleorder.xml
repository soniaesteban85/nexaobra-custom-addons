<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document_image" inherit_id="sale.report_saleorder_document" priority="16">
        <!-- Encabezado de la columna de imagen -->
        <xpath expr="//table[hasclass('o_main_table')]//thead//tr//th[1]" position="before">
            <th name="th_image" class="text-center" style="width: 65px; vertical-align: middle; padding: 6px;">Imagen</th>
        </xpath>

        <!-- Celda de la imagen del producto -->
        <xpath expr="//table[hasclass('o_main_table')]//tbody//tr//td[1]" position="before">
            <td name="td_image" class="text-center" style="width: 65px; vertical-align: middle; padding: 4px;">
                <t t-if="line.product_id and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)" style="max-height: 50px; max-width: 50px; width: auto; height: auto; object-fit: contain; border-radius: 4px; border: 1px solid #e2e8f0; padding: 2px;" alt="Producto"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
